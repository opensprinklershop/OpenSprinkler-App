# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# NPM package location
node_modules/

# Build output
build/

# Cordova folders
platforms/
plugins/

# OS X build output
project.xcworkspace/
xcuserdata/

# Coverage data
coverage

# VS Code
typings/
.vscode/**/
.vscode/plugins.json

# Visual Studio
.vs/

# Local environment variables
.secrets.json
.env

# Local deploy secrets (SSH keys, IONOS webspace host/user) - must never be committed
deploy-ionos.inc

# HTTPS deploy path (alternative "self-update" upload) - local only, contains
# credentials / webspace specifics; must never be committed
deploy-secrets/
deploy-upload.php
deploy-https-upload.js

# OS Meta data files
Thumbs.db
.DS_Store
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# Editor / Log data
*~
*.sw[mnpcod]
*.log
*.tmp
*.bak
*.backup
*.orig
*.rej
*.tmp.*
log.txt
*.sublime-project
*.sublime-workspace
npm-debug.log*
.idea/
DEADJOE
*.sav
# Firebase
.firebase
GoogleService-Info.plist
cert
